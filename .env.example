# Do not commit a real .env file. Set these in your terminal or host dashboard.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vp_optimizer

# Administrator-only password for the Admin login tab.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required in hosted production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: enables the Continue with Google button.
# Create an OAuth 2.0 Web application in Google Cloud Console and use the exact callback below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

PORT=8080
