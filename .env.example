# Do not commit a real .env file. Set these variables in your terminal or host dashboard.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vp_optimizer

# Required: the password entered on the VP Optimizer sign-in screen.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required in hosted production. Generate one, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

PORT=8080
